# Copy to .env.local for local dev. Set the same vars in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://gjhconsulting.net

# Contact + newsletter delivery via Resend (https://resend.com)
# Until these are set, /api/contact returns 503 contact-not-configured
# and /api/newsletter returns 503 newsletter-not-configured (forms show the error inline).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: defaults to NEWSLETTER_FROM_EMAIL when unset. Must be a verified sender domain in Resend.
CONTACT_FROM_EMAIL=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_AUDIENCE_ID=
